# GEMINI_API_KEY: Optional if AI summarization is used
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# TWELVEDATA_API_KEY: Free API key from https://twelvedata.com (800 requests/day free forever)
TWELVEDATA_API_KEY="demo"

# MONGODB_URI: Optional MongoDB Atlas connection string. If omitted, uses seamless in-memory database
MONGODB_URI=""

# PORT: Server port (defaults to 3000 in AI Studio / dev, 10000 on Render)
PORT=3000
